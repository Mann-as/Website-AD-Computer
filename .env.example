# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT Secret for Authentication (minimum 32 random characters)
JWT_SECRET="replace-with-a-long-random-secret-before-production"

# Google Gemini / AI Service API Key
# Jika dibiarkan placeholder / kosong, AI otomatis memakai fallback lokal (FAQ + template).
GEMINI_API_KEY="your-gemini-api-key-here"

# Telegram Notification
# Buat bot lewat @BotFather lalu isi token bot di bawah.
# Chat ID admin bisa didapat dari @userinfobot atau hasil getUpdates.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_API_BASE="https://api.telegram.org"

# Application Settings
NEXT_PUBLIC_APP_NAME="AD Computer - Service Komputer & IT Services"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
